{
  "name": "entitlement-api",
  "version": "0.1.0",
  "description": "Subscription, entitlement and licensing API",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,yml,yaml,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,yml,yaml,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:test:deploy": "node scripts/prepare-test-db.mjs",
    "db:seed": "node prisma/seed.mjs",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.2.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "18.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
