// Prisma schema for the entitlement API.
// Docs: https://pris.ly/d/prisma-schema
//
// The domain models (Product, Plan, Subscription, Order, License, ...) land in
// the next step. This file only wires the MySQL datasource and the client
// generator so migrations and `prisma generate` can run from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Who an account belongs to: the email is the identity, and possession of it
/// is proven by a verification code at login. The row is created on the first
/// successful login, so `emailVerifiedAt` is always set from the start.
///
/// The role lives here rather than in deployment configuration so that
/// administrator privileges are an auditable property of a real user.
model User {
  id               String               @id @default(cuid())
  email            String               @unique @db.VarChar(254)
  displayName      String?              @db.VarChar(120)
  role             UserRole             @default(CUSTOMER)
  status           UserStatus           @default(ACTIVE)
  emailVerifiedAt  DateTime?            @db.DateTime(3)
  lastLoginAt      DateTime?            @db.DateTime(3)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @db.DateTime(3)
  subscriptions    Subscription[]
  trialRedemptions TrialRedemption[]
  requestedChanges SubscriptionChange[]
  orders           Order[]
  refunds          Refund[]
  notifications    OutboundNotification[]

  @@index([status])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/// DISABLED keeps the account and its history but refuses every login.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// A short-lived login code sent to a mailbox.
///
/// Deliberately independent of `User`: the code proves control of the address
/// before any account exists, so a first-time sign-in needs no user row yet.
/// `codeHash` is an HMAC of the code and its recipient, never the code itself.
/// Only the newest unconsumed row per address can be redeemed, and
/// `attemptsRemaining` bounds guessing.
model VerificationCode {
  id                String    @id @default(cuid())
  email             String    @db.VarChar(254)
  codeHash          String    @db.VarChar(64)
  expiresAt         DateTime  @db.DateTime(3)
  attemptsRemaining Int       @default(5)
  consumedAt        DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)

  @@index([email, consumedAt])
  @@index([email, createdAt])
}

/// A sellable product. Descriptive metadata only: pricing and features live
/// on its plans, so editing a product page never changes what a customer owns.
model Product {
  id               String            @id @default(cuid())
  code             String            @unique @db.VarChar(64)
  displayName      String            @db.VarChar(120)
  description      String?           @db.Text
  vendor           String?           @db.VarChar(120)
  websiteUrl       String?           @db.VarChar(2048)
  iconUrl          String?           @db.VarChar(2048)
  /// String[] stored as JSON. Presentation only.
  tags             Json?
  sortOrder        Int               @default(0)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @db.DateTime(3)
  plans            Plan[]
  subscriptions    Subscription[]
  trialRedemptions TrialRedemption[]
  orders           Order[]

  @@index([active, sortOrder])
}

/// A way of selling one product: the edition the customer is entitled to
/// (`standard`, `pro`). Only identity and shop presentation live here. Price,
/// billing terms, device limits and features are content, and content
/// belongs to an immutable `PlanVersion` — so editing this row can never change
/// what an existing subscriber owns.
///
/// There is deliberately no `active` flag: whether an edition can still be
/// bought is answered by "does it have a PUBLISHED version", one single source
/// of truth instead of two switches that can disagree.
model Plan {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String        @db.VarChar(64)
  displayName String        @db.VarChar(120)
  description String?       @db.Text
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)
  versions    PlanVersion[]

  @@unique([productId, code])
  @@index([productId, sortOrder])
}

/// The state of a version decides who may start using it.
///
/// `PUBLISHED` is current: sold to new customers and renewed by existing ones.
/// `CLOSED_FOR_SALE` is grandfathered: no new purchase, but subscribers already
/// pinned to it keep renewing at their original terms. `RETIRED` stops both and
/// is only referenced by history. Transitions are one-way.
///
/// A period, once created, keeps working whatever happens to the version: the
/// only thing retirement stops is the *next* period.
enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  CLOSED_FOR_SALE
  RETIRED
}

/// An immutable snapshot of everything a customer is buying.
///
/// The freeze point is `DRAFT -> PUBLISHED`: after that, prices and feature
/// values may not change, because some subscription may already be pinned to
/// them or may pin to them at its next renewal. A commercial change is a new
/// version, never an edit.
///
/// `publishedKey` carries the plan id while the version is PUBLISHED and NULL
/// otherwise; its uniqueness (MySQL allows many NULLs) is how "at most one
/// sellable version per plan" is enforced without partial indexes.
model PlanVersion {
  id                  String               @id @default(cuid())
  planId              String
  plan                Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Monotonic within the plan and never reused.
  version             Int
  status              PlanVersionStatus    @default(DRAFT)
  publishedKey        String?              @unique @db.VarChar(191)
  /// Devices one paid seat may activate. A period snapshots this value.
  maxActivations      Int                  @default(1)
  /// Free days this edition offers, independent of the term. 0 means no trial.
  trialDays           Int                  @default(0)
  /// Activation limit of the trial variant; ignored when trialDays is 0.
  trialMaxActivations Int                  @default(1)
  publishedAt         DateTime?            @db.DateTime(3)
  /// Set when the version stops accepting new subscriptions but keeps renewing.
  saleClosedAt        DateTime?            @db.DateTime(3)
  retiredAt           DateTime?            @db.DateTime(3)
  createdAt           DateTime             @default(now()) @db.DateTime(3)
  updatedAt           DateTime             @updatedAt @db.DateTime(3)
  prices              PlanVersionPrice[]
  features            PlanVersionFeature[]
  periods             SubscriptionPeriod[]
  scheduledChanges    SubscriptionChange[]
  orders              Order[]

  @@unique([planId, version])
  @@index([status])
}

/// One billing term of a version. The term is a commercial attribute of the
/// purchase, never of the entitlement: switching from monthly to yearly keeps
/// the same plan code and opens a new period.
model PlanVersionPrice {
  id            String       @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  interval      PlanInterval
  currency      String       @default("cny") @db.Char(3)
  priceCents    Int
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @db.DateTime(3)

  @@unique([planVersionId, interval, currency])
}

enum PlanInterval {
  MONTH
  YEAR
}

/// A catalogue-wide capability that plans can grant, e.g. `ai-assistant`.
/// Features are boolean: a `PlanVersionFeature` row means "included" and its
/// absence means "not included", so there is no value to interpret.
model Feature {
  id          String               @id @default(cuid())
  code        String               @unique @db.VarChar(64)
  displayName String               @db.VarChar(120)
  description String?              @db.Text
  createdAt   DateTime             @default(now()) @db.DateTime(3)
  updatedAt   DateTime             @updatedAt @db.DateTime(3)
  versions    PlanVersionFeature[]
}

/// A capability a version grants. The row is the whole statement: present
/// means included, absent means not included. Rows are frozen together with
/// their version, so a running period always reads the same list.
model PlanVersionFeature {
  id            String      @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  featureId     String
  feature       Feature     @relation(fields: [featureId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)

  @@unique([planVersionId, featureId])
  @@index([featureId])
}

/// A user's contract with one product.
///
/// Deliberately carries no plan id: the plan is decided by the version pinned to
/// each period, so "upgrade Standard -> Pro" is just the next period pinning a
/// Pro version while the contract and its pricing history stay one row.
///
/// `openKey` holds `${userId}:${productId}` while the subscription is live and
/// NULL once it is terminal; its uniqueness stops a user from holding two live
/// subscriptions to the same product while still allowing a later resubscribe.
model Subscription {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus   @default(ACTIVE)
  openKey          String?              @unique @db.VarChar(191)
  startedAt        DateTime             @db.DateTime(3)
  endedAt          DateTime?            @db.DateTime(3)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @db.DateTime(3)
  periods          SubscriptionPeriod[]
  changes          SubscriptionChange[]
  trialRedemptions TrialRedemption[]
  orders           Order[]
  activations      DeviceActivation[]

  @@index([userId, status])
  @@index([status])
}

/// One machine that consumed an activation slot of the license a subscription
/// grants. The license itself is not a table: it is derived from the active
/// period and the version that period pinned, so it can never disagree with
/// the subscription.
///
/// `activeKey` holds `${subscriptionId}:${machineId}` while the activation is
/// live and NULL once the device is deactivated; its uniqueness makes obtain
/// idempotent while still allowing the same machine to be activated again
/// later (and keeps the deactivation history auditable).
model DeviceActivation {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  machineId       String       @db.VarChar(128)
  activeKey       String?      @unique @db.VarChar(191)
  activatedAt     DateTime     @default(now()) @db.DateTime(3)
  lastRefreshedAt DateTime     @default(now()) @db.DateTime(3)
  deactivatedAt   DateTime?    @db.DateTime(3)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  @@index([subscriptionId])
  @@index([machineId])
}

/// `PAUSED` freezes entitlement and renewal but keeps the period clock running;
/// it is not the same thing as "frozen terms", which is what a period is.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

enum SubscriptionPeriodKind {
  TRIAL
  PAID
}

enum SubscriptionPeriodStatus {
  ACTIVE
  CLOSED
}

/// Why a period ended. `RENEWED` and `CHANGED` both continue the subscription
/// with a fresh period; `CANCELED`, `PAUSED` and `EXPIRED` do not.
enum SubscriptionPeriodCloseReason {
  RENEWED
  CHANGED
  CANCELED
  PAUSED
  EXPIRED
}

/// One billing term — the unit that gets frozen.
///
/// Created in the same transaction that closes the previous one, so the pinned
/// version, the commercial terms and the window are all decided at once and
/// never edited afterwards. A period that ends early records that fact in
/// `endedAt` instead of rewriting `endsAt`, which keeps the planned schedule
/// auditable.
///
/// `currentKey` holds the subscription id while the period is ACTIVE and NULL
/// otherwise, so "at most one running period per subscription" is a unique
/// index rather than an application convention.
model SubscriptionPeriod {
  id             String                         @id @default(cuid())
  subscriptionId String
  subscription   Subscription                   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Contiguous and monotonic within the subscription; identifies the term.
  sequence       Int
  planVersionId  String
  planVersion    PlanVersion                    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  kind           SubscriptionPeriodKind
  status         SubscriptionPeriodStatus       @default(ACTIVE)
  currentKey     String?                        @unique @db.VarChar(191)
  /// Commercial terms, frozen at creation. All NULL for a TRIAL period.
  interval       PlanInterval?
  unitPriceCents Int?
  currency       String?                        @db.Char(3)
  /// Device limit in force for this period; a trial uses trialMaxActivations.
  maxActivations Int
  startsAt       DateTime                       @db.DateTime(3)
  endsAt         DateTime                       @db.DateTime(3)
  endedAt        DateTime?                      @db.DateTime(3)
  closeReason    SubscriptionPeriodCloseReason?
  createdAt      DateTime                       @default(now()) @db.DateTime(3)
  updatedAt      DateTime                       @updatedAt @db.DateTime(3)
  appliedChanges SubscriptionChange[]           @relation("ChangeAppliedPeriod")
  sourceOrders   Order[]                        @relation("OrderSourcePeriod")
  appliedOrder   Order?                         @relation("OrderAppliedPeriod")

  @@unique([subscriptionId, sequence])
  @@index([subscriptionId, status])
  @@index([planVersionId])
}

/// An intent to change the contract, recorded before it takes effect.
///
/// This is where the terms the customer agreed to are frozen: the target version
/// and the target term are captured when the request is accepted, so a catalog
/// edit between request and boundary cannot silently change the deal. At the
/// boundary the intent is validated again and either applied, or marked FAILED
/// — never silently replaced by something else.
///
/// `pendingKey` holds the subscription id while the change is PENDING and NULL
/// otherwise, so one subscription can have at most one outstanding intent.
model SubscriptionChange {
  id                  String                   @id @default(cuid())
  subscriptionId      String
  subscription        Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind                SubscriptionChangeKind
  status              SubscriptionChangeStatus @default(PENDING)
  targetPlanVersionId String?
  targetPlanVersion   PlanVersion?             @relation(fields: [targetPlanVersionId], references: [id], onDelete: Restrict)
  targetInterval      PlanInterval?
  /// When the intent becomes due. Change and cancel intents use the current
  /// period end, which is the only moment they may take effect.
  effectiveAt         DateTime                 @db.DateTime(3)
  pendingKey          String?                  @unique @db.VarChar(191)
  requestedByUserId   String?
  requestedByUser     User?                    @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedAt         DateTime                 @default(now()) @db.DateTime(3)
  appliedAt           DateTime?                @db.DateTime(3)
  appliedPeriodId     String?
  appliedPeriod       SubscriptionPeriod?      @relation("ChangeAppliedPeriod", fields: [appliedPeriodId], references: [id], onDelete: SetNull)
  failureReason       String?                  @db.VarChar(120)
  createdAt           DateTime                 @default(now()) @db.DateTime(3)
  updatedAt           DateTime                 @updatedAt @db.DateTime(3)
  order               Order?

  @@index([subscriptionId, status])
  @@index([status, effectiveAt])
  @@index([targetPlanVersionId])
}

enum SubscriptionChangeKind {
  CHANGE
  CANCEL
  PAUSE
  RESUME
}

enum SubscriptionChangeStatus {
  PENDING
  APPLIED
  CANCELED
  FAILED
}

/// A trial can be taken once per user and product for life, independently of how
/// many times the subscription is started or canceled.
model TrialRedemption {
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  firstRedeemedAt DateTime      @default(now()) @db.DateTime(3)

  @@id([userId, productId])
  @@index([productId])
}

/// What a payment is buying. `NEW_SUBSCRIPTION` has no subscription yet — the
/// row is created by fulfilment; `RENEWAL` and `TRIAL_CONVERSION` extend an
/// existing one at its next boundary.
enum OrderKind {
  NEW_SUBSCRIPTION
  RENEWAL
  TRIAL_CONVERSION
}

/// `PAID` but not `FULFILLED` is a real state: money arrived and the order is
/// waiting for the period boundary (a renewal paid early) or for a failed
/// fulfilment to be retried. Money is never silently dropped.
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CLOSED
  REFUNDED
}

/// A commercial intent frozen before any money moves.
///
/// The price, the version and the term are captured here, so publishing a new
/// plan version cannot change what an already-created order costs. Fulfilment
/// is what turns `PAID` into a subscription period, and `appliedPeriodId`
/// makes that transition happen at most once.
///
/// The table is named `PaymentOrder`: `Order` is a reserved word in MySQL and
/// every raw lock query would otherwise need quoting by hand.
model Order {
  id              String                @id @default(cuid())
  /// Human-readable, also used as the provider's `out_trade_no`.
  number          String                @unique @db.VarChar(32)
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Set by fulfilment for a new subscription; known up front for a renewal.
  subscriptionId  String?
  subscription    Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  kind            OrderKind
  status          OrderStatus           @default(PENDING)
  planVersionId   String
  planVersion     PlanVersion           @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  /// Commercial terms, frozen at creation.
  interval        PlanInterval
  unitPriceCents  Int
  currency        String                @db.Char(3)
  amountCents     Int
  /// `${userId}:${productId}` while the order is PENDING, so one product slot
  /// cannot accumulate two unpaid checkouts.
  pendingKey      String?               @unique @db.VarChar(191)
  /// The period being renewed while the order is PENDING: one renewal order
  /// per period.
  renewalKey      String?               @unique @db.VarChar(191)
  sourcePeriodId  String?
  sourcePeriod    SubscriptionPeriod?   @relation("OrderSourcePeriod", fields: [sourcePeriodId], references: [id], onDelete: Restrict)
  /// Frozen scheduled change this order pays for; applied together with the
  /// period it creates.
  changeId        String?               @unique
  change          SubscriptionChange?   @relation(fields: [changeId], references: [id], onDelete: Restrict)
  /// The period created when the order was fulfilled.
  appliedPeriodId String?               @unique
  appliedPeriod   SubscriptionPeriod?   @relation("OrderAppliedPeriod", fields: [appliedPeriodId], references: [id], onDelete: SetNull)
  /// New order: checkout deadline. Renewal: the end of the period being bought,
  /// because an unpaid renewal expires with that period.
  expiresAt       DateTime              @db.DateTime(3)
  paidAt          DateTime?             @db.DateTime(3)
  fulfilledAt     DateTime?             @db.DateTime(3)
  closedAt        DateTime?             @db.DateTime(3)
  failureReason   String?               @db.VarChar(120)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @db.DateTime(3)
  payments        Payment[]
  refunds         Refund[]
  notifications   PaymentNotification[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([subscriptionId, status])
  @@index([productId])
  @@map("PaymentOrder")
}

/// The payment channel. Alipay is the only live channel; development and test
/// substitute a log gateway rather than adding a second domain provider.
enum PaymentProvider {
  ALIPAY
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
}

/// One attempt to collect an order. `successKey` holds the order id only while
/// SUCCEEDED, so the unique index enforces "at most one winning attempt".
model Payment {
  id              String                @id @default(cuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  /// Provider-specific channel, e.g. `ALIPAY_PAGE`.
  channel         String?               @db.VarChar(32)
  status          PaymentStatus         @default(INITIATED)
  amountCents     Int
  currency        String                @db.Char(3)
  /// Provider transaction id (Alipay `trade_no`), unique once known.
  providerTradeNo String?               @db.VarChar(64)
  successKey      String?               @unique @db.VarChar(191)
  buyerId         String?               @db.VarChar(64)
  failureCode     String?               @db.VarChar(64)
  failureMessage  String?               @db.VarChar(255)
  initiatedAt     DateTime              @default(now()) @db.DateTime(3)
  paidAt          DateTime?             @db.DateTime(3)
  closedAt        DateTime?             @db.DateTime(3)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @db.DateTime(3)
  refunds         Refund[]
  notifications   PaymentNotification[]

  @@unique([provider, providerTradeNo])
  @@index([orderId, status])
}

enum PaymentNotificationStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Inbound provider callback, stored before it is acted on.
///
/// `(provider, externalId)` makes a replayed callback a no-op instead of a
/// double fulfilment, and keeping the raw payload means a failed handler can
/// be replayed offline.
model PaymentNotification {
  id           String                    @id @default(cuid())
  provider     PaymentProvider
  /// Provider event id (Alipay `notify_id`) or a digest when absent.
  externalId   String                    @db.VarChar(128)
  verified     Boolean                   @default(false)
  eventType    String                    @db.VarChar(64)
  orderId      String?
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId    String?
  payment      Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status       PaymentNotificationStatus @default(RECEIVED)
  payload      Json
  errorMessage String?                   @db.VarChar(255)
  receivedAt   DateTime                  @default(now()) @db.DateTime(3)
  processedAt  DateTime?                 @db.DateTime(3)
  createdAt    DateTime                  @default(now()) @db.DateTime(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A refund never exceeds what was collected: the service adds up SUCCEEDED and
/// PENDING rows before creating the next one.
model Refund {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents       Int
  currency          String       @db.Char(3)
  reason            String       @db.VarChar(255)
  status            RefundStatus @default(PENDING)
  providerRefundNo  String?      @unique @db.VarChar(64)
  requestedByUserId String?
  requestedByUser   User?        @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedAt       DateTime     @default(now()) @db.DateTime(3)
  completedAt       DateTime?    @db.DateTime(3)
  failureReason     String?      @db.VarChar(120)

  @@index([orderId, status])
}

/// A short lease that lets exactly one process execute a scheduled job.
///
/// `lockedUntil` is compared against the database clock, never the process
/// clock, so replicas with skewed time still agree on who holds the job. A
/// crashed holder simply lets the lease expire; no cleanup task is required.
model JobLock {
  name        String   @id @db.VarChar(64)
  owner       String   @db.VarChar(128)
  lockedUntil DateTime @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// One execution of a scheduled job.
///
/// `result` keeps the counters the job returned, so an operator can tell a
/// quiet night from a job that never ran. Scheduled ticks that lose the lock
/// are not recorded (they would only produce noise); manual runs are, with
/// status SKIPPED, because somebody explicitly asked for them.
model JobRun {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(64)
  status       JobRunStatus @default(RUNNING)
  startedAt    DateTime     @default(now()) @db.DateTime(3)
  finishedAt   DateTime?    @db.DateTime(3)
  durationMs   Int?
  result       Json?
  errorMessage String?      @db.VarChar(255)
  instanceId   String       @db.VarChar(128)
  createdAt    DateTime     @default(now()) @db.DateTime(3)

  @@index([name, startedAt])
  @@index([status, startedAt])
}

/// What an outbound message is about. Only the events that actually change
/// what the customer owns are sent by mail; marketing is not a domain event.
enum NotificationType {
  PAYMENT_SUCCEEDED
  SUBSCRIPTION_EXPIRED
  REFUND_ISSUED
}

enum OutboundNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Transactional outbox for customer mail.
///
/// The row is written in the same transaction as the business change, so a
/// captured payment can never exist without its receipt and a rolled-back
/// change never sends a message. Delivery is a separate job: it claims rows,
/// sends them, and retries with backoff. `dedupeKey` makes a replayed callback
/// or a retried job enqueue at most one message.
model OutboundNotification {
  id            String                      @id @default(cuid())
  userId        String?
  user          User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Recipient snapshot: the address that was valid when the event happened.
  email         String                      @db.VarChar(254)
  type          NotificationType
  status        OutboundNotificationStatus  @default(PENDING)
  subject       String                      @db.VarChar(200)
  payload       Json
  dedupeKey     String?                     @unique @db.VarChar(191)
  attempts      Int                         @default(0)
  /// When the next attempt is due; NULL means "as soon as possible".
  nextAttemptAt DateTime?                   @db.DateTime(3)
  claimedAt     DateTime?                   @db.DateTime(3)
  sentAt        DateTime?                   @db.DateTime(3)
  lastError     String?                     @db.VarChar(255)
  createdAt     DateTime                    @default(now()) @db.DateTime(3)
  updatedAt     DateTime                    @updatedAt @db.DateTime(3)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
