// Prisma schema for the entitlement API.
// Docs: https://pris.ly/d/prisma-schema
//
// The domain models (Product, Plan, Subscription, Order, License, ...) land in
// the next step. This file only wires the MySQL datasource and the client
// generator so migrations and `prisma generate` can run from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Who an account belongs to: the email is the identity, and possession of it
/// is proven by a verification code at login. The row is created on the first
/// successful login, so `emailVerifiedAt` is always set from the start.
///
/// The role lives here rather than in deployment configuration so that
/// administrator privileges are an auditable property of a real user.
model User {
  id              String     @id @default(cuid())
  email           String     @unique @db.VarChar(254)
  displayName     String?    @db.VarChar(120)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @db.DateTime(3)
  lastLoginAt     DateTime?  @db.DateTime(3)
  createdAt       DateTime   @default(now()) @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @db.DateTime(3)

  @@index([status])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/// DISABLED keeps the account and its history but refuses every login.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// A short-lived login code sent to a mailbox.
///
/// Deliberately independent of `User`: the code proves control of the address
/// before any account exists, so a first-time sign-in needs no user row yet.
/// `codeHash` is an HMAC of the code and its recipient, never the code itself.
/// Only the newest unconsumed row per address can be redeemed, and
/// `attemptsRemaining` bounds guessing.
model VerificationCode {
  id                String    @id @default(cuid())
  email             String    @db.VarChar(254)
  codeHash          String    @db.VarChar(64)
  expiresAt         DateTime  @db.DateTime(3)
  attemptsRemaining Int       @default(5)
  consumedAt        DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)

  @@index([email, consumedAt])
  @@index([email, createdAt])
}

/// A sellable product. Descriptive metadata only: pricing and entitlements live
/// on its plans, so editing a product page never changes what a customer owns.
model Product {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  displayName String   @db.VarChar(120)
  description String?  @db.Text
  vendor      String?  @db.VarChar(120)
  websiteUrl  String?  @db.VarChar(2048)
  iconUrl     String?  @db.VarChar(2048)
  /// String[] stored as JSON. Presentation only.
  tags        Json?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  plans       Plan[]

  @@index([active, sortOrder])
}

/// A way of selling one product: the edition the customer is entitled to
/// (`standard`, `pro`). The billing term is not part of its identity, so the
/// same plan is sold monthly and yearly through its prices.
model Plan {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code                String   @db.VarChar(64)
  displayName         String   @db.VarChar(120)
  description         String?  @db.Text
  /// Devices one paid seat may activate. A license snapshots this value.
  maxActivations      Int      @default(1)
  /// Free days this edition offers, independent of the term. 0 means no trial.
  trialDays           Int      @default(0)
  /// Activation limit of the trial variant; ignored when trialDays is 0.
  trialMaxActivations Int      @default(1)
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
  prices              PlanPrice[]
  features            PlanFeature[]

  @@unique([productId, code])
  @@index([productId, active, sortOrder])
}

/// One billing term of a plan. The term is a commercial attribute of the
/// purchase, never of the entitlement: switching from monthly to yearly keeps
/// the same plan code.
model PlanPrice {
  id         String       @id @default(cuid())
  planId     String
  plan       Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  interval   PlanInterval
  currency   String       @default("cny") @db.Char(3)
  priceCents Int
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)

  @@unique([planId, interval, currency])
}

enum PlanInterval {
  MONTH
  YEAR
}

/// A catalogue-wide capability that plans can grant, e.g. `ai-assistant`.
/// `valueType` tells readers how to interpret the JSON value on PlanFeature.
model Feature {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(64)
  displayName String           @db.VarChar(120)
  description String?          @db.Text
  valueType   FeatureValueType @default(BOOLEAN)
  /// Display hint for numeric values, e.g. `devices` or `projects`.
  unit        String?          @db.VarChar(32)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @db.DateTime(3)
  plans       PlanFeature[]
}

enum FeatureValueType {
  BOOLEAN
  NUMBER
  TEXT
}

/// The value a plan grants for one feature; a missing row means "not
/// included". The value's shape follows `Feature.valueType`.
model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  value     Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([planId, featureId])
  @@index([featureId])
}
