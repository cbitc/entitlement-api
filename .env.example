# Copy to `.env` and adjust. Every value is validated at boot by
# `src/config/env.schema.ts`; an invalid value fails the process immediately.

NODE_ENV="development"
APP_NAME="entitlement-api"
APP_VERSION="0.1.0"

# HTTP listener.
HOST="0.0.0.0"
PORT="3000"

# Prisma datasource (MySQL). Must use the `mysql://` scheme.
DATABASE_URL="mysql://entitlement:entitlement@localhost:3306/entitlement"

# Logging. `pretty` is human readable and only meant for development;
# production always uses newline-delimited JSON.
LOG_LEVEL="debug"
# LOG_FORMAT="pretty"

# Maximum JSON / form body size.
BODY_LIMIT="1mb"

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS="http://localhost:5173"

# Swagger UI. Disabled by default in production.
SWAGGER_ENABLED="true"
SWAGGER_PATH="docs"

# Global rate limit (in-memory storage).
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"
