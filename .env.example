# Copy to `.env` and adjust. Every value is validated at boot by
# `src/config/env.schema.ts`; an invalid value fails the process immediately.

NODE_ENV="development"
APP_NAME="entitlement-api"
APP_VERSION="0.1.0"

# HTTP listener.
HOST="0.0.0.0"
PORT="3000"

# Prisma datasource (MySQL). Must use the `mysql://` scheme.
DATABASE_URL="mysql://entitlement:entitlement@localhost:3306/entitlement"

# Logging. `pretty` is human readable and only meant for development;
# production always uses newline-delimited JSON.
LOG_LEVEL="debug"
# LOG_FORMAT="pretty"
# Log successful requests. Set to "false" to keep only 4xx/5xx and
# application events when tailing a busy server.
LOG_HTTP_SUCCESS="true"

# Maximum JSON / form body size.
BODY_LIMIT="1mb"

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS="http://localhost:5173"

# Swagger UI. Disabled by default in production.
SWAGGER_ENABLED="true"
SWAGGER_PATH="docs"

# Global rate limit (in-memory storage).
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"

# In-process scheduler. Set to "false" to run jobs only through
# `POST /admin/jobs/:name/run`. Tests disable it automatically.
# SCHEDULER_ENABLED="true"
JOB_SETTLE_INTERVAL_MS="300000"
JOB_RENEWAL_ORDERS_INTERVAL_MS="3600000"
JOB_EXPIRE_ORDERS_INTERVAL_MS="300000"
JOB_SYNC_PAYMENTS_INTERVAL_MS="900000"
JOB_NOTIFICATIONS_INTERVAL_MS="30000"
JOB_BATCH_SIZE="200"
# A crashed holder blocks a job for at most this long; live runs renew it.
JOB_LOCK_TTL_MS="60000"

# Lets an administrator move the application clock for integration testing
# (`GET|POST /admin/clock`). Development only: the process refuses to start in
# production with this on. The database clock and Alipay timestamps stay real.
# CLOCK_CONTROL_ENABLED="true"

# Transactional customer mail (payment receipts, expirations, refunds).
NOTIFICATION_BATCH_SIZE="50"
NOTIFICATION_MAX_ATTEMPTS="5"
NOTIFICATION_TIME_ZONE="Asia/Shanghai"
# Base URL of the customer portal used in message links.
WEB_APP_URL="http://localhost:5173"

# Session tokens (JWT, HS256). The secret must be at least 32 characters.
# Session tokens are always issued by this API, even when login happens at an
# identity provider: the IdP proves who the user is, the session stays local.
JWT_SECRET="dev-only-secret-please-change-me-32+chars"
JWT_ISSUER="entitlement-api"
JWT_AUDIENCE="entitlement-api"
JWT_TTL_SECONDS="3600"

# Single sign-on (OIDC authorization code + PKCE). Register this API as a
# confidential client at the IdP and use the same redirect URI there.
# `SSO_ISSUER` must match the IdP's `iss` claim exactly.
SSO_ISSUER="http://localhost:8080/realms/entitlement"
SSO_CLIENT_ID="entitlement-api"
# Must match `clients[0].secret` in docker/keycloak/entitlement-realm.json.
SSO_CLIENT_SECRET="dev-only-keycloak-secret"
SSO_REDIRECT_URI="http://localhost:3000/auth/sso/callback"
SSO_SCOPES="openid profile email"
SSO_STATE_TTL_SECONDS="600"
# How long the one-time ticket handed to the SPA stays valid.
SSO_TICKET_TTL_SECONDS="60"
SSO_HTTP_TIMEOUT_MS="5000"
# Comma separated allow-list; empty accepts every verified address.
# SSO_ALLOWED_EMAIL_DOMAINS="example.com"

# License tokens (EdDSA/Ed25519) served to desktop clients. The private key is
# a PKCS#8 PEM or its raw base64 DER; generate one with
# `node scripts/generate-license-key.mjs`. Required in production; development
# and tests use an ephemeral key when it is empty.
LICENSE_JWT_PRIVATE_KEY=""
LICENSE_JWT_KID="lic-1"
LICENSE_JWT_ISSUER="entitlement-api"
# The desktop SDK expects this audience by default.
LICENSE_JWT_AUDIENCE="entitlement-client"
LICENSE_TTL_SECONDS="43200"
LICENSE_OFFLINE_TTL_DAYS="30"

# Mail delivery. `log` prints messages and is development/test only; `smtp`
# is mandatory in production.
MAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Entitlement Portal <no-reply@example.com>"

# Database used by the e2e suite. `pnpm db:test:deploy` applies the migrations.
DATABASE_URL_TEST="mysql://entitlement:entitlement@localhost:3306/entitlement_test"


# Payments. `log` is a development/test stand-in for Alipay: it fabricates a
# checkout URL and accepts unsigned callbacks. Production must use `alipay`.
# PAYMENT_PROVIDER="log"
ORDER_TTL_MINUTES="30"
RENEWAL_LEAD_DAYS="7"
# A capture that arrives just after the checkout closed is still applied.
LATE_PAYMENT_GRACE_MINUTES="30"
# How far back the reconciliation sweep looks for missed captures.
PAYMENT_SYNC_WINDOW_HOURS="72"
ALIPAY_APP_ID=""
# PKCS#8 private key and Alipay public key, raw base64 or full PEM.
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
# Sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY_URL="https://openapi.alipay.com/gateway.do"
PAYMENT_NOTIFY_URL="http://localhost:3000/payments/alipay/notify"
PAYMENT_RETURN_URL="http://localhost:5173/checkout/return"
