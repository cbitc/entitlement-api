{
  "realm": "entitlement",
  "displayName": "Entitlement Portal",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "entitlement-api",
      "name": "Entitlement API",
      "description": "Relying party for the entitlement portal and admin console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/auth/sso/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:5174/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic"
      ]
    }
  ],
  "users": [
    {
      "username": "buyer@example.com",
      "email": "buyer@example.com",
      "firstName": "Test",
      "lastName": "Buyer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "buyer",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "firstName": "Portal",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ]
}